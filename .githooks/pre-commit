#!/usr/bin/env bash
# SAE pre-commit gate: the same checks CI runs (CLAUDE.md "Tests"), plus a secret scan.
# Enable once per clone: git config core.hooksPath .githooks
# Skip only in an emergency: SAE_SKIP_HOOKS=1 git commit ...   (say why in the commit body)
set -euo pipefail

if [ "${SAE_SKIP_HOOKS:-}" = "1" ]; then
  echo "pre-commit: SKIPPED by SAE_SKIP_HOOKS=1" >&2
  exit 0
fi

cd "$(git rev-parse --show-toplevel)"
staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0

fail() { echo "pre-commit: FAILED: $1" >&2; exit 1; }

# 1. Secrets: block likely keys/tokens in staged content.
if git diff --cached -U0 --diff-filter=ACM | grep -E '^\+' \
   | grep -nEi '(api[_-]?key|secret|token|passwd|password)[[:space:]]*[:=][[:space:]]*["'\''][^"'\'' ]{12,}|AKIA[0-9A-Z]{16}|-----BEGIN [A-Z ]*PRIVATE KEY-----|sk-[A-Za-z0-9_-]{20,}|ghp_[A-Za-z0-9]{30,}' ; then
  fail "possible secret in staged changes (see lines above)"
fi

# 2. Python gates.
echo "pre-commit: ruff" >&2
uv run ruff check || fail "ruff check"
echo "pre-commit: mypy --strict src/sae" >&2
uv run mypy --strict src/sae || fail "mypy --strict src/sae"
echo "pre-commit: pytest (full suite, about 5 min)" >&2
uv run pytest -q -p no:cacheprovider || fail "pytest"

# 3. Mod static check when the mod changed.
if echo "$staged" | grep -q '^mod/sae_bridge/'; then
  echo "pre-commit: mod checker" >&2
  uv run python3 mod/sae_bridge/tools/check_mod.py || fail "check_mod.py"
  uv run pytest -q -p no:cacheprovider mod/sae_bridge/tests || fail "mod tests"
fi

# 4. Rust gates when the parser changed.
if echo "$staged" | grep -q '^parser/'; then
  [ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"
  echo "pre-commit: cargo fmt/clippy/test" >&2
  (cd parser && cargo fmt --check) || fail "cargo fmt --check"
  (cd parser && cargo clippy -j 1 --all-targets -- -D warnings) || fail "cargo clippy"
  (cd parser && cargo test -j 1) || fail "cargo test"
fi

echo "pre-commit: all gates passed" >&2
