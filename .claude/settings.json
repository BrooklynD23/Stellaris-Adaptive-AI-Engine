{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"$CLAUDE_PROJECT_DIR/.sae-dev/enabled\" ] && python3 \"$CLAUDE_PROJECT_DIR/tools/devdash/dd.py\" hook session-start ; exit 0",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent|Task|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"$CLAUDE_PROJECT_DIR/.sae-dev/enabled\" ] && { exec 3<&0; python3 \"$CLAUDE_PROJECT_DIR/tools/devdash/dd.py\" hook pre-tool <&3 >/dev/null 2>&1 3<&- & } ; exit 0",
            "timeout": 2
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"$CLAUDE_PROJECT_DIR/.sae-dev/enabled\" ] && { exec 3<&0; python3 \"$CLAUDE_PROJECT_DIR/tools/devdash/dd.py\" hook subagent-stop <&3 >/dev/null 2>&1 3<&- & } ; exit 0",
            "timeout": 2
          }
        ]
      }
    ]
  }
}
