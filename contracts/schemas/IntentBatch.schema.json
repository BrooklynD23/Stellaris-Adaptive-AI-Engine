        "country",
        "posture",
        "target"
      ],
      "title": "SetMilitaryPosture",
      "type": "object"
    },
    "Stance": {
      "description": "``DIPLO_STANCE`` values; ``code`` is written to ``sae_p_dip``.",
      "enum": [
        "friendly",
        "neutral",
        "rival",
        "hostile"
      ],
      "title": "Stance",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Everything emitted in one ``sae_in.ini`` write. One batch = one ``seq``.",
  "properties": {
    "attempt": {
      "default": 1,
      "description": "2 = the single re-emission after LOST.",
      "maximum": 2,
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "intents": {
      "default": [],
      "items": {
        "discriminator": {
          "mapping": {
            "DIPLO_STANCE": "#/$defs/DiploStance",
            "NOOP_HEARTBEAT": "#/$defs/NoopHeartbeat",
            "SET_ECON_PLAN": "#/$defs/SetEconPlan",
            "SET_MILITARY_POSTURE": "#/$defs/SetMilitaryPosture"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/SetEconPlan"
          },
          {
            "$ref": "#/$defs/SetMilitaryPosture"
          },
          {
            "$ref": "#/$defs/DiploStance"
          },
          {
            "$ref": "#/$defs/NoopHeartbeat"
          }
        ]
      },
      "title": "Intents",
      "type": "array"
    },
    "issued_date": {
      "title": "Issued Date",
      "type": "string"
    },
    "issued_m": {
      "description": "Latest HB month counter seen when the batch was compiled.",
      "maximum": 1000000,
      "minimum": 0,
      "title": "Issued M",
      "type": "integer"
    },
    "knobs": {
      "anyOf": [
        {
          "$ref": "#/$defs/KnobCommand"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "seq": {
      "maximum": 1000000,
      "minimum": 1,
      "title": "Seq",
      "type": "integer"
    }
  },
  "required": [
    "seq",
    "issued_date",
    "issued_m"
  ],
  "title": "IntentBatch",
  "type": "object"
}
