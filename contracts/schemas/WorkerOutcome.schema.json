{
  "$defs": {
    "Cost": {
      "additionalProperties": false,
      "description": "Worker self-measured cost (resource proposal section 3).",
      "properties": {
        "cpu_s": {
          "minimum": 0,
          "title": "Cpu S",
          "type": "number"
        },
        "rss_peak_bytes": {
          "minimum": 0,
          "title": "Rss Peak Bytes",
          "type": "integer"
        },
        "wall_s": {
          "minimum": 0,
          "title": "Wall S",
          "type": "number"
        }
      },
      "required": [
        "rss_peak_bytes",
        "cpu_s",
        "wall_s"
      ],
      "title": "Cost",
      "type": "object"
    }
  },
  "additionalProperties": false,
